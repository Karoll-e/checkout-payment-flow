{
  "info": {
    "name": "Checkout Payment Flow - Backend API",
    "description": "Postman collection para probar los endpoints del backend de checkout con Wompi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "checkout-payment-flow"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "",
      "type": "string"
    },
    {
      "key": "transactionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "GET - Listar productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "response": []
        },
        {
          "name": "GET - Obtener producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{productId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Transactions",
      "item": [
        {
          "name": "POST - Crear transacción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"customer\": {\n    \"name\": \"Juan Pérez\",\n    \"email\": \"juan.perez@example.com\",\n    \"phone\": \"+573001234567\"\n  },\n  \"delivery\": {\n    \"address\": \"Calle 123 #45-67\",\n    \"city\": \"Bogotá\"\n  },\n  \"deliveryFee\": 15000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Response has transaction id', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.id).to.exist;",
                  "  pm.environment.set('transactionId', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST - Confirmar pago (con card_token de Wompi)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardToken\": \"tok_test_visa_approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}", "confirm"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Transaction status updated', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(['APPROVED', 'DECLINED', 'ERROR']).to.include(jsonData.status);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET - Obtener estado de transacción",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Flujos Completos",
      "item": [
        {
          "name": "1. Obtener productos + Guardar productId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products",
              "host": ["{{baseUrl}}"],
              "path": ["products"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Products loaded', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData).to.be.an('array');",
                  "  if (jsonData.length > 0) {",
                  "    pm.environment.set('productId', jsonData[0].id);",
                  "    console.log('Product ID saved:', jsonData[0].id);",
                  "  }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Crear transacción (PENDING)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1,\n  \"customer\": {\n    \"name\": \"María González\",\n    \"email\": \"maria.gonzalez@example.com\",\n    \"phone\": \"+573109876543\"\n  },\n  \"delivery\": {\n    \"address\": \"Carrera 7 #32-16\",\n    \"city\": \"Medellín\"\n  },\n  \"deliveryFee\": 12000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["transactions"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Transaction created with PENDING status', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.status).to.equal('PENDING');",
                  "  pm.environment.set('transactionId', jsonData.id);",
                  "  console.log('Transaction ID saved:', jsonData.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Confirmar pago con tarjeta de prueba VISA (APROBADA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardToken\": \"tok_test_visa_approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}", "confirm"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment approved', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.status).to.equal('APPROVED');",
                  "  pm.expect(jsonData.wompiTransactionId).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3b. Confirmar pago con tarjeta de prueba MASTERCARD (RECHAZADA)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardToken\": \"tok_test_mastercard_declined\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}", "confirm"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Payment declined', function () {",
                  "  const jsonData = pm.response.json();",
                  "  pm.expect(jsonData.status).to.equal('DECLINED');",
                  "  pm.expect(jsonData.errorMessage).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Consultar estado final de transacción",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/transactions/{{transactionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["transactions", "{{transactionId}}"]
            }
          }
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [],
        "type": "text/javascript"
      }
    }
  ]
}